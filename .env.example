# --- Supabase (Project Settings -> API Keys) ---
# Newer projects show "sb_publishable_..." (use as ANON_KEY) and "sb_secret_..." (use as SERVICE_ROLE_KEY).
# The database password is NOT needed by this app.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR-PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-public-key"
# Server only. Used by the cron and Telegram routes. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Cron (cron-job.org) ---
# Any long random string. cron-job.org must send it as:  Authorization: Bearer <CRON_SECRET>
CRON_SECRET="generate-a-long-random-string"

# --- Email reminders (https://resend.com) - optional ---
RESEND_API_KEY=""
REMINDER_FROM_EMAIL="StackTrack <reminders@yourdomain.com>"

# --- Telegram reminders (main channel) ---
# After adding these and redeploying, use Settings -> Telegram reminders -> "Set up bot".
TELEGRAM_BOT_TOKEN=""
# Any long string of letters, numbers, _ or - (Telegram rejects other characters).
TELEGRAM_WEBHOOK_SECRET=""
# Optional: the app reads the bot username from Telegram automatically.
NEXT_PUBLIC_TELEGRAM_BOT_USERNAME=""

# Public URL of the deployed app (used in reminder links)
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"
