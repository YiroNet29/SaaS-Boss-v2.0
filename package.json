{
  "name": "stacktrack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit --noUnusedLocals",
    "test": "tsx --conditions=react-server --test src/utils/*.test.ts src/lib/*.test.ts",
    "dev:local": "next dev -H 127.0.0.1 -p 3210",
    "local:start": "npx --yes supabase@3.0.0 start && node scripts/local-env.mjs",
    "local:stop": "npx --yes supabase@3.0.0 stop",
    "local:reset": "npx --yes supabase@3.0.0 db reset",
    "local:env": "node scripts/local-env.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "lucide-react": "^0.546.0",
    "next": "16.4.5",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.10.1",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
